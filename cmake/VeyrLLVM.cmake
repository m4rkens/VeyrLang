include_guard(GLOBAL)

# Kept separate from discovery so CTest can exercise rejected export policies
# without acquiring packages or linking incompatible libraries.
function(veyr_validate_llvm_exports consumer_runtime)
  if(NOT LLVM_PACKAGE_VERSION VERSION_EQUAL "23.1.2")
    message(FATAL_ERROR "Veyr LLVM policy: exact LLVM 23.1.2 required; actual=${LLVM_PACKAGE_VERSION}")
  endif()
  if(NOT LLVM_BUILD_TYPE STREQUAL "Release" OR
     NOT LLVM_ABI_BREAKING_CHECKS STREQUAL "FORCE_OFF" OR LLVM_ENABLE_SHARED_LIBS)
    message(FATAL_ERROR "Veyr LLVM policy: static Release LLVM with ABI-breaking checks FORCE_OFF required")
  endif()
  if(NOT LLVM_TARGETS_TO_BUILD STREQUAL "X86" OR NOT TARGET LLVMSupport)
    message(FATAL_ERROR "Veyr LLVM policy: X86 and native LLVMSupport target required")
  endif()
  get_target_property(_imported LLVMSupport IMPORTED)
  get_target_property(_type LLVMSupport TYPE)
  if(NOT _imported OR NOT _type STREQUAL "STATIC_LIBRARY")
    message(FATAL_ERROR "Veyr LLVM policy: LLVMSupport must be a native imported static library")
  endif()
  if(WIN32)
    if(NOT LLVM_HOST_TRIPLE MATCHES "^x86_64-.*windows-msvc" OR
       NOT LLVM_TARGET_TRIPLE MATCHES "^x86_64-.*windows-msvc")
      message(FATAL_ERROR "Veyr LLVM policy: native Windows x86_64 LLVM triples required")
    endif()
    # Upstream LLVMConfig exports its CRT by setting this consumer variable.
    set(_package_runtime "${CMAKE_MSVC_RUNTIME_LIBRARY}")
    string(FIND "${_package_runtime}"
      "$<$<CONFIG:${LLVM_BUILD_TYPE}>:${consumer_runtime}>" _runtime_match)
    if(NOT _package_runtime STREQUAL consumer_runtime AND _runtime_match EQUAL -1)
      message(FATAL_ERROR "Veyr LLVM policy: package CRT '${_package_runtime}' differs from consumer '${consumer_runtime}'")
    endif()
  else()
    if(NOT LLVM_HOST_TRIPLE MATCHES "^x86_64-.*linux-gnu" OR
       NOT LLVM_TARGET_TRIPLE MATCHES "^x86_64-.*linux-gnu")
      message(FATAL_ERROR "Veyr LLVM policy: native Linux x86_64 GNU LLVM triples required")
    endif()
    separate_arguments(_definitions NATIVE_COMMAND "${LLVM_DEFINITIONS}")
    if(NOT "-D_GLIBCXX_USE_CXX11_ABI=1" IN_LIST _definitions)
      message(FATAL_ERROR "Veyr LLVM policy: package requires the reviewed libstdc++11 ABI=1")
    endif()
  endif()
  set(_abi_header_found FALSE)
  foreach(_include IN LISTS LLVM_INCLUDE_DIRS)
    if(EXISTS "${_include}/llvm/Config/abi-breaking.h")
      file(STRINGS "${_include}/llvm/Config/abi-breaking.h" _abi
        REGEX "^#define LLVM_ENABLE_ABI_BREAKING_CHECKS 0$")
      if(NOT _abi)
        message(FATAL_ERROR "Veyr LLVM policy: package header ABI checks must be disabled")
      endif()
      set(_abi_header_found TRUE)
    endif()
  endforeach()
  if(NOT _abi_header_found)
    message(FATAL_ERROR "Veyr LLVM policy: generated package ABI header missing")
  endif()
endfunction()

function(veyr_configure_llvm)
  if(NOT VEYR_LLVM_PROVIDER MATCHES "^(managed|system|custom)$")
    message(FATAL_ERROR "Select VEYR_LLVM_PROVIDER managed, system or custom; no fallback")
  endif()
  set(_consumer_runtime "${CMAKE_MSVC_RUNTIME_LIBRARY}")
  # Do not let an earlier provider's cached LLVM_DIR override the selected one.
  unset(LLVM_DIR CACHE)
  unset(LLVM_DIR)
  if(VEYR_LLVM_PROVIDER STREQUAL "managed")
    if(VEYR_LLVM_DIR)
      message(FATAL_ERROR "Managed LLVM uses Conan-native discovery; omit external VEYR_LLVM_DIR")
    endif()
    find_package(LLVM 23.1.2 EXACT CONFIG REQUIRED NO_DEFAULT_PATH PATHS ${CMAKE_PREFIX_PATH})
  else()
    if(NOT IS_ABSOLUTE "${VEYR_LLVM_DIR}" OR NOT EXISTS "${VEYR_LLVM_DIR}/LLVMConfig.cmake")
      message(FATAL_ERROR "External LLVM requires an explicit existing native LLVMConfig.cmake directory; no acquisition or fallback")
    endif()
    find_package(LLVM 23.1.2 EXACT CONFIG REQUIRED NO_DEFAULT_PATH PATHS "${VEYR_LLVM_DIR}")
  endif()
  veyr_validate_llvm_exports("${_consumer_runtime}")
  # LLVMConfig may change this variable; retain the explicitly selected CRT.
  set(CMAKE_MSVC_RUNTIME_LIBRARY "${_consumer_runtime}")
  foreach(_target IN LISTS LLVM_AVAILABLE_LIBS)
    if(TARGET "${_target}")
      get_target_property(_imported "${_target}" IMPORTED)
      if(_imported)
        set_property(TARGET "${_target}" PROPERTY MAP_IMPORTED_CONFIG_DEBUG Release)
      endif()
    endif()
  endforeach()
  include(CheckCXXSourceCompiles)
  if(WIN32)
    if(CMAKE_BUILD_TYPE STREQUAL "Debug")
      set(_debug_condition "!defined(_DEBUG) || _ITERATOR_DEBUG_LEVEL != 2")
    else()
      set(_debug_condition "defined(_DEBUG) || _ITERATOR_DEBUG_LEVEL != 0")
    endif()
    set(_runtime_source "#include <vector>\n#if !defined(_DLL) || !defined(_MT) || ${_debug_condition}\n#error Wrong selected CRT or iterator ABI\n#endif\nint main() { return 0; }")
  else()
    set(_runtime_source "#include <string>\n#if !defined(__GLIBCXX__) || _GLIBCXX_USE_CXX11_ABI != 1\n#error Wrong selected libstdc++ ABI\n#endif\nint main() { return 0; }")
  endif()
  unset(VEYR_CONSUMER_RUNTIME_COMPATIBLE CACHE)
  check_cxx_source_compiles("${_runtime_source}" VEYR_CONSUMER_RUNTIME_COMPATIBLE)
  if(NOT VEYR_CONSUMER_RUNTIME_COMPATIBLE)
    message(FATAL_ERROR "Veyr LLVM policy: consumer runtime/iterator ABI does not match the reviewed native profile")
  endif()
  add_library(veyr_llvm_support INTERFACE)
  target_include_directories(veyr_llvm_support SYSTEM INTERFACE ${LLVM_INCLUDE_DIRS})
  separate_arguments(_definitions NATIVE_COMMAND "${LLVM_DEFINITIONS}")
  target_compile_options(veyr_llvm_support INTERFACE ${_definitions})
  target_link_libraries(veyr_llvm_support INTERFACE LLVMSupport)
  message(STATUS "Veyr LLVM: provider=${VEYR_LLVM_PROVIDER}; version=${LLVM_PACKAGE_VERSION}; config=${LLVM_DIR}; build=${LLVM_BUILD_TYPE}; ABI=${LLVM_ABI_BREAKING_CHECKS}; triple=${LLVM_HOST_TRIPLE}; consumer=${CMAKE_BUILD_TYPE}; CRT=${_consumer_runtime}")
endfunction()
