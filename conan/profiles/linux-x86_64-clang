# Reviewed Omarchy developer (Clang 22) and Ubuntu CI (Clang 18) policies are separate.
# Doctor supplies the reviewed major and explicit GCC root; CI execution remains gated.
# Paths come from the reviewed native environment, never profile detect.
[settings]
os=Linux
arch=x86_64
compiler=clang
compiler.version={{ os.environ["VEYR_CLANG_MAJOR"] }}
compiler.cppstd=23
compiler.libcxx=libstdc++11
llvm/*:build_type=Release

[conf]
tools.build:compiler_executables={{ {"c": os.environ["VEYR_C_COMPILER"], "cpp": os.environ["VEYR_CPP_COMPILER"]} | tojson }}
tools.build:cflags={{ ['--gcc-install-dir="' + os.environ["VEYR_GCC_INSTALL_DIR"] + '"'] | tojson }}
tools.build:cxxflags={{ ['--gcc-install-dir="' + os.environ["VEYR_GCC_INSTALL_DIR"] + '"'] | tojson }}
tools.build:exelinkflags={{ ['--ld-path="' + os.environ["VEYR_LINKER"] + '"'] | tojson }}
tools.build:sharedlinkflags={{ ['--ld-path="' + os.environ["VEYR_LINKER"] + '"'] | tojson }}
tools.cmake.cmaketoolchain:extra_variables={{ {"CMAKE_LINKER": os.environ["VEYR_LINKER"]} | tojson }}
